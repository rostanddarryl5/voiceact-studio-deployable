# Copiez ce fichier vers .env avant `docker compose up --build`.
# En production, utilisez au minimum 32 caractères aléatoires.
VOICEACT_INTERNAL_TOKEN=remplacez-moi-par-un-secret-long-et-aleatoire
VOICEACT_RELEASE=0.1.0
VOICEACT_BIND_ADDRESS=127.0.0.1
VOICEACT_PORT=3100

# Profil CPU fiable. `small` est adapté au lancement; `medium` est plus précis mais plus lent.
VOICEACT_MODEL_SIZE=small
VOICEACT_DEVICE=cpu
VOICEACT_COMPUTE_TYPE=int8
VOICEACT_MAX_CONCURRENCY=1
VOICEACT_PRELOAD_MODEL=true

# Délai maximal du service privé d'alignement phonémique MFA.
VOICEACT_PHONEME_TIMEOUT_SECONDS=210

# `whisperx`: meilleur effort avec repli local automatique vers faster-whisper.
# `required`: l'analyse échoue si WhisperX échoue. `off`: faster-whisper uniquement.
VOICEACT_INSTALL_WHISPERX=true
VOICEACT_ALIGNMENT=whisperx

# Aucun crédit payant par défaut. N'activez le secours que volontairement.
VOICEACT_ALLOW_OPENAI_FALLBACK=false
OPENAI_API_KEY=
