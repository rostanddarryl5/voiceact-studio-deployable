# Développement local: le navigateur ne reçoit jamais ces secrets.
VOICEACT_TRANSCRIPTION_PROVIDER=local
VOICEACT_SPEECH_SERVICE_URL=http://127.0.0.1:8000
VOICEACT_SPEECH_SERVICE_TOKEN=changez-ce-secret

# Secours OpenAI strictement optionnel et désactivé par défaut.
VOICEACT_ALLOW_OPENAI_FALLBACK=false
OPENAI_API_KEY=

# Le service Python doit recevoir la même valeur que VOICEACT_SPEECH_SERVICE_TOKEN.
VOICEACT_INTERNAL_TOKEN=changez-ce-secret
VOICEACT_MODEL_SIZE=small
VOICEACT_DEVICE=cpu
VOICEACT_COMPUTE_TYPE=int8
VOICEACT_ALIGNMENT=off
VOICEACT_MAX_UPLOAD_MB=24
VOICEACT_MAX_CONCURRENCY=1
VOICEACT_PRELOAD_MODEL=false

# Optionnel en développement local. En production Compose utilise le service MFA privé.
VOICEACT_PHONEME_SERVICE_URL=
VOICEACT_PHONEME_SERVICE_TOKEN=changez-ce-secret
VOICEACT_PHONEME_TIMEOUT_SECONDS=210

# Génération des références VoiceAct. Secret serveur uniquement : ne jamais
# préfixer cette variable avec NEXT_PUBLIC_ et ne jamais l'envoyer au navigateur.
GEMINI_API_KEY= AIzaSyCeuIJZT8njSxdTc1Hho65AIhl6PBqbzps
VOICEACT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
VOICEACT_GEMINI_TTS_FREE_TIER=true
