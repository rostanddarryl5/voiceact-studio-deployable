FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN groupadd --system --gid 10001 voiceact \
    && useradd --system --uid 10001 --gid voiceact voiceact

COPY --chown=voiceact:voiceact .next-share/standalone ./
COPY --chown=voiceact:voiceact public ./public
COPY --chown=voiceact:voiceact .next-share/static ./.next-share/static

USER voiceact
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
