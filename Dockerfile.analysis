# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/tmp/voiceact/huggingface \
    XDG_CACHE_HOME=/tmp/voiceact/cache \
    TORCH_HOME=/tmp/voiceact/torch \
    VOICEACT_MODEL_SIZE=tiny \
    VOICEACT_DEVICE=cpu \
    VOICEACT_COMPUTE_TYPE=int8 \
    VOICEACT_ALIGNMENT=off \
    VOICEACT_MAX_CONCURRENCY=1 \
    VOICEACT_PRELOAD_MODEL=false \
    PORT=8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /tmp/voiceact/huggingface /tmp/voiceact/cache /tmp/voiceact/torch

WORKDIR /service

COPY speech-service/requirements.txt /tmp/speech-requirements.txt
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r /tmp/speech-requirements.txt

COPY speech-service ./speech-service

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=10s --start-period=90s --retries=6 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.getenv(\"PORT\", \"8000\")}/health/ready', timeout=8)" || exit 1

WORKDIR /service/speech-service
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers"]
